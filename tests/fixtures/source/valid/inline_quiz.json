        "content": "# Queue ordering\n\nA queue removes the oldest item first."
      }
    },
    {
      "type": "code",
      "id": "implementation",
      "source": {
        "kind": "inline",
        "content": "fn pop(queue: &mut VecDeque<Item>) -> Option<Item> {\n    queue.pop_front()\n}"
      }
    },
    {
      "type": "diff",
      "id": "ordering-change",
      "source": {
        "kind": "inline",
        "content": "diff --git a/src/queue.rs b/src/queue.rs\nindex 1111111..2222222 100644\n--- a/src/queue.rs\n+++ b/src/queue.rs\n@@ -1 +1 @@\n-queue.pop_back()\n+queue.pop_front()\n"
      }
    },
