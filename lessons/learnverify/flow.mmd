flowchart LR
    Agent["Authoring agent"]
    Lesson["lesson.json"]
    Load["load_lesson<br/>same pipeline as learnc check"]
    Plan["plan<br/>one job per quiz or highlighted block"]
    Cache["answer cache<br/>per user, 24 h"]
    Jev["TypeSafe Jev API"]
